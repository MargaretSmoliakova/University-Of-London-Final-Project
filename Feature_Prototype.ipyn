import re
from pathlib import Path
from functools import lru_cache
import numpy as np
import pandas as pd
import tensorflow as tf
from PIL import Image
import pydicom
from pydicom.pixel_data_handlers.util import apply_voi_lut
from sklearn.model_selection import GroupShuffleSplit
from sklearn.metrics import (
    accuracy_score, precision_score, f1_score, roc_auc_score, confusion_matrix
)

# Configuration
dataset_path = Path("D:/UoL_Final_Project_Dataset/dataset/cbis_ddsm")

random_seed = 42
image_size = (224, 224)
batch_size = 16
max_epochs = 30
target_sensitivity = 0.90

tf.random.set_seed(random_seed)
np.random.seed(random_seed)

pathology_to_label = {"BENIGN": 0, "BENIGN_WITHOUT_CALLBACK": 0, "MALIGNANT": 1}
image_path_columns = ["cropped image file path", "image file path"]
case_id_pattern = re.compile(r"(Mass|Calc)-(Training|Test)_P_\d+_(LEFT|RIGHT)_(CC|MLO)_\d+", re.I)
metadata_files_by_lesion_type = {
    "mass": ("mass_case_description_train_set.csv", "mass_case_description_test_set.csv"),
    "calcification": ("calc_case_description_train_set.csv", "calc_case_description_test_set.csv"),
}


# Load metadata
def load_metadata(csv_filename, lesion_type):
    metadata = pd.read_csv(dataset_path / csv_filename)
    metadata["lesion_type"] = lesion_type
    metadata["label"] = metadata["pathology"].astype(str).str.upper().str.strip().map(pathology_to_label)
    metadata = metadata.dropna(subset=["label"]).reset_index(drop=True)
    metadata["label"] = metadata["label"].astype(int)
    return metadata


full_train_metadata = pd.concat(
    [load_metadata(files[0], lesion_type) for lesion_type, files in metadata_files_by_lesion_type.items()],
    ignore_index=True,
)
test_metadata = pd.concat(
    [load_metadata(files[1], lesion_type) for lesion_type, files in metadata_files_by_lesion_type.items()],
    ignore_index=True,
)


# Image reading and normalisation
def read_pixel_array(image_path):
    image_path = str(image_path)
    if image_path.lower().endswith(".dcm"):
        dicom = pydicom.dcmread(image_path)
        pixels = apply_voi_lut(dicom.pixel_array, dicom).astype(np.float32)
        if str(dicom.get("PhotometricInterpretation", "")).upper() == "MONOCHROME1":
            pixels = pixels.max() - pixels
        return pixels
    return np.asarray(Image.open(image_path).convert("L"), dtype=np.float32)


def normalise_pixels(pixels):
    low, high = np.percentile(pixels, (1, 99))
    pixels = np.clip(pixels, low, high)
    return ((pixels - low) / (high - low + 1e-6)).astype(np.float32)


@lru_cache(maxsize=20000)
def looks_like_mask(image_path):
    try:
        intensities = read_pixel_array(image_path).ravel()
    except Exception:
        return False
    if intensities.size > 200000:
        intensities = intensities[:: intensities.size // 200000 + 1]
    return np.unique(intensities).size <= 20


# Image path resolution 
def index_images_by_case_id(dataset_root):
    case_id_to_paths = {}
    for dicom_path in dataset_root.rglob("*.dcm"):
        match = case_id_pattern.search(dicom_path.as_posix())
        if match:
            case_id = match.group(0)
            case_id_to_paths.setdefault(case_id, []).append(dicom_path)
    return case_id_to_paths


case_id_to_image_paths = index_images_by_case_id(dataset_path)


def choose_best_image(candidate_paths):
    candidate_paths = [path for path in candidate_paths if path.exists()]
    if not candidate_paths:
        return None
    tissue_images = [path for path in candidate_paths if not looks_like_mask(str(path))]
    return str((tissue_images or candidate_paths)[0])


def resolve_image_path(row):
    path_reference = next(
        (row[column] for column in image_path_columns if column in row and pd.notna(row[column])), None
    )
    if path_reference is None:
        return None
    path_reference = str(path_reference).replace("\\", "/")
    direct_path = dataset_path / path_reference
    if direct_path.exists():
        return str(direct_path)
    match = case_id_pattern.search(path_reference)
    if match and match.group(0) in case_id_to_image_paths:
        return choose_best_image(case_id_to_image_paths[match.group(0)])
    return None


for metadata in (full_train_metadata, test_metadata):
    metadata["image_path"] = metadata.apply(resolve_image_path, axis=1)

full_train_metadata = full_train_metadata.dropna(subset=["image_path"]).reset_index(drop=True)
test_metadata = test_metadata.dropna(subset=["image_path"]).reset_index(drop=True)
print("Train cases:", len(full_train_metadata), "| Test cases:", len(test_metadata))

# Flag  images that still look like ROI masks
for split_name, metadata in (("train", full_train_metadata), ("test", test_metadata)):
    mask_like_count = sum(looks_like_mask(image_path) for image_path in metadata["image_path"])
    if mask_like_count:
        print(f"Warning: {mask_like_count} selected {split_name} images look like ROI masks — "
              f"inspect before trusting results.")


# Patient-level validation split
group_splitter = GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=random_seed)
train_index, validation_index = next(
    group_splitter.split(full_train_metadata, groups=full_train_metadata["patient_id"])
)
train_metadata = full_train_metadata.iloc[train_index].reset_index(drop=True)
validation_metadata = full_train_metadata.iloc[validation_index].reset_index(drop=True)


# Save a few preprocessed images
def save_sample_images(metadata, count=12, output_dir="sample_check"):
    Path(output_dir).mkdir(exist_ok=True)
    for index, image_path in enumerate(metadata["image_path"].head(count)):
        pixels = normalise_pixels(read_pixel_array(image_path))
        Image.fromarray((pixels * 255).astype(np.uint8)).resize(image_size).save(
            Path(output_dir) / f"sample_{index:02d}.png"
        )
    print(f"Saved {min(count, len(metadata))} preprocessed samples to '{output_dir}/' — "
          f"open them to confirm they are lesion crops, not full mammograms or masks.")


save_sample_images(train_metadata)


# Image pipeline
def preprocess_image(image_path_bytes):
    pixels = normalise_pixels(read_pixel_array(image_path_bytes.decode("utf-8")))
    return pixels[..., None]


def load_image_tensor(image_path, label):
    image = tf.numpy_function(preprocess_image, [image_path], tf.float32)
    image.set_shape((None, None, 1))
    image = tf.image.resize(image, image_size)
    image = tf.image.grayscale_to_rgb(image)
    return image, tf.cast(label, tf.float32)


def make_dataset(metadata, shuffle=False):
    dataset = tf.data.Dataset.from_tensor_slices(
        (metadata["image_path"].values, metadata["label"].values.astype(np.float32))
    )
    if shuffle:
        dataset = dataset.shuffle(len(metadata), seed=random_seed)
    return (
        dataset.map(load_image_tensor, num_parallel_calls=tf.data.AUTOTUNE)
        .batch(batch_size)
        .prefetch(tf.data.AUTOTUNE)
    )


train_dataset = make_dataset(train_metadata, shuffle=True)
validation_dataset = make_dataset(validation_metadata)
test_dataset = make_dataset(test_metadata)


# Baseline CNN
def build_baseline_cnn():
    model = tf.keras.Sequential([
        tf.keras.layers.Input((*image_size, 3)),
        tf.keras.layers.Conv2D(32, 3, activation="relu", padding="same"),
        tf.keras.layers.MaxPooling2D(),
        tf.keras.layers.Conv2D(64, 3, activation="relu", padding="same"),
        tf.keras.layers.MaxPooling2D(),
        tf.keras.layers.Conv2D(128, 3, activation="relu", padding="same"),
        tf.keras.layers.MaxPooling2D(),
        tf.keras.layers.GlobalAveragePooling2D(),
        tf.keras.layers.Dense(64, activation="relu"),
        tf.keras.layers.Dense(1, activation="sigmoid"),
    ])
    model.compile(
        optimizer=tf.keras.optimizers.Adam(1e-3),
        loss="binary_crossentropy",
        metrics=[tf.keras.metrics.AUC(name="auc")],
    )
    return model


model = build_baseline_cnn()

label_counts = train_metadata["label"].value_counts()
class_weights = {class_label: len(train_metadata) / (2 * label_counts[class_label]) for class_label in label_counts.index}

model.fit(
    train_dataset, validation_data=validation_dataset, epochs=max_epochs,
    class_weight=class_weights
)


# Evaluation
def compute_metrics(true_labels, predicted_probabilities, threshold):
    predicted_labels = (predicted_probabilities >= threshold).astype(int)
    true_neg, false_pos, false_neg, true_pos = confusion_matrix(
        true_labels, predicted_labels, labels=[0, 1]
    ).ravel()
    return {
        "threshold": float(threshold),
        "accuracy": accuracy_score(true_labels, predicted_labels),
        "sensitivity": true_pos / (true_pos + false_neg) if (true_pos + false_neg) else np.nan,
        "specificity": true_neg / (true_neg + false_pos) if (true_neg + false_pos) else np.nan,
        "precision": precision_score(true_labels, predicted_labels, zero_division=0),
        "f1_score": f1_score(true_labels, predicted_labels, zero_division=0),
        "roc_auc": roc_auc_score(true_labels, predicted_probabilities),
        "confusion": (int(true_neg), int(false_pos), int(false_neg), int(true_pos)),
    }


def select_high_sensitivity_threshold(true_labels, predicted_probabilities, target):
    best_threshold, best_specificity = 0.5, -1.0
    for threshold in np.linspace(0, 1, 1001):
        predicted_labels = (predicted_probabilities >= threshold).astype(int)
        true_neg, false_pos, false_neg, true_pos = confusion_matrix(
            true_labels, predicted_labels, labels=[0, 1]
        ).ravel()
        sensitivity = true_pos / (true_pos + false_neg) if (true_pos + false_neg) else 0.0
        specificity = true_neg / (true_neg + false_pos) if (true_neg + false_pos) else 0.0
        if sensitivity >= target and specificity > best_specificity:
            best_threshold, best_specificity = threshold, specificity
    return best_threshold


def print_report(title, metrics):
    print(f"\n{title}  (threshold = {metrics['threshold']:.2f})")
    print(f"    accuracy    : {metrics['accuracy']:.3f}")
    print(f"    sensitivity : {metrics['sensitivity']:.3f}   (recall of malignant cases)")
    print(f"    specificity : {metrics['specificity']:.3f}")
    print(f"    precision   : {metrics['precision']:.3f}")
    print(f"    f1_score    : {metrics['f1_score']:.3f}")
    print(f"    roc_auc     : {metrics['roc_auc']:.3f}")
    true_neg, false_pos, false_neg, true_pos = metrics["confusion"]
    print(f"    confusion   : TN={true_neg}  FP={false_pos}  FN={false_neg}  TP={true_pos}")


# Select the high-sensitivity threshold on the validation set, then apply it to the test set.
validation_probabilities = model.predict(validation_dataset).ravel()
validation_labels = validation_metadata["label"].values
high_sensitivity_thresh = select_high_sensitivity_threshold(
    validation_labels, validation_probabilities, target_sensitivity
)

test_probabilities = model.predict(test_dataset).ravel()
test_labels = test_metadata["label"].values

print("\n" + "=" * 70)
print("Baseline CNN")



print(f"High-sensitivity threshold selected on the validation set: {high_sensitivity_thresh:.2f}")
print("=" * 70)

print_report("Overall, test set @ default threshold", compute_metrics(test_labels, test_probabilities, 0.5))
print_report("Overall, test set @ high-sensitivity threshold",
             compute_metrics(test_labels, test_probabilities, high_sensitivity_thresh))

print("\n" + "-" * 70)
print("Results by lesion type (where available)")
print("-" * 70)
test_metadata["predicted_probability"] = test_probabilities
for lesion_type, subset in test_metadata.groupby("lesion_type"):
    subset_labels = subset["label"].values
    subset_probabilities = subset["predicted_probability"].values
    print_report(f"{lesion_type} @ default threshold", compute_metrics(subset_labels, subset_probabilities, 0.5))
    print_report(f"{lesion_type} @ high-sensitivity threshold",
                 compute_metrics(subset_labels, subset_probabilities, high_sensitivity_thresh))